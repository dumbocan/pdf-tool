# pdf-tool environment template. Copy to .env and adjust; never commit .env.

PORT=3000
MAX_REQUEST_BYTES=16777216
MAX_RESPONSE_BYTES=1048576
LOG_LEVEL=info

# Optional bearer auth for both POST routes. When unset, POST routes are open
# by documented deployment policy (fail-open); GET routes are always public.
AUTH_TOKEN=

# MiniMax LLM route. Unsetting MINIMAX_API_KEY disables /extract-with-llm
# (503 "LLM service is not configured") while /extract stays intact.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
